generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  HARDWARE
  ADDON
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHECK
  ONLINE
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role                 @default(CUSTOMER)
  phone              String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  customer           Customer?
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]
  recordedPayments   Payment[]            @relation("StaffPayments")

  @@index([role])
}

model Customer {
  id             String         @id @default(uuid())
  userId         String?        @unique
  companyName    String
  contactName    String
  email          String         @unique
  phone          String
  billingAddress String
  city           String?
  state          String?
  country        String?
  postalCode     String?
  taxNumber      String?
  currency       String         @default("INR")
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotations     Quotation[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
  discountUsages DiscountUsage[]

  @@index([companyName])
  @@index([email])
}

model Product {
  id             String           @id @default(uuid())
  name           String
  code           String           @unique
  type           ProductType      @default(SOFTWARE)
  salesPrice     Decimal          @db.Decimal(12, 2)
  costPrice      Decimal          @db.Decimal(12, 2)
  notes          String?
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]
  quotationItems QuotationItem[]
  subscriptionItems SubscriptionItem[]
  invoiceItems   InvoiceItem[]
  discounts      Discount[]

  @@index([code])
  @@index([isArchived])
}

model ProductVariant {
  id              String         @id @default(uuid())
  productId       String
  name            String
  description     String?
  additionalPrice Decimal        @default(0.00) @db.Decimal(12, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationItems  QuotationItem[]
  subscriptionItems SubscriptionItem[]
  invoiceItems    InvoiceItem[]

  @@index([productId])
}

model SubscriptionPlan {
  id                String           @id @default(uuid())
  name              String
  description       String?
  basePrice         Decimal          @db.Decimal(12, 2)
  billingFrequency  BillingFrequency @default(MONTHLY)
  minQuantity       Int              @default(1)
  startDate         DateTime
  endDate           DateTime?
  autoClose         Boolean          @default(false)
  allowEarlyClosure Boolean          @default(true)
  allowPause        Boolean          @default(true)
  allowRenewal      Boolean          @default(true)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  subscriptions     Subscription[]
  quotationItems    QuotationItem[]

  @@index([billingFrequency])
  @@index([isActive])
}

model QuotationTemplate {
  id           String      @id @default(uuid())
  name         String
  description  String?
  validityDays Int         @default(30)
  itemsJson    Json
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  quotations   Quotation[]
}

model Quotation {
  id              String            @id @default(uuid())
  quotationNumber String            @unique
  customerId      String
  templateId      String?
  status          QuotationStatus   @default(DRAFT)
  validUntil      DateTime
  subtotal        Decimal           @db.Decimal(12, 2)
  taxAmount       Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal           @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  template        QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  subscription    Subscription?

  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id           String            @id @default(uuid())
  quotationId  String
  productId    String
  variantId    String?
  planId       String?
  quantity     Int               @default(1)
  unitPrice    Decimal           @db.Decimal(12, 2)
  taxRate      Decimal           @default(0.00) @db.Decimal(5, 2)
  discountRate Decimal           @default(0.00) @db.Decimal(5, 2)
  amount       Decimal           @db.Decimal(12, 2)

  quotation    Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique
  customerId         String
  quotationId        String?            @unique
  planId             String
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  expiryDate         DateTime?
  nextBillingDate    DateTime
  paymentTerms       String             @default("Due on Receipt")
  autoClose          Boolean            @default(false)
  subtotal           Decimal            @db.Decimal(12, 2)
  taxAmount          Decimal            @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal            @db.Decimal(12, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation          Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  items              SubscriptionItem[]
  invoices           Invoice[]
  discountUsages     DiscountUsage[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionItem {
  id             String          @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  amount         Decimal         @db.Decimal(12, 2)

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
}

model TaxRule {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discount {
  id                 String          @id @default(uuid())
  code               String          @unique
  name               String
  type               DiscountType    @default(PERCENTAGE)
  value              Decimal         @db.Decimal(12, 2)
  minPurchaseAmount  Decimal?        @db.Decimal(12, 2)
  minQuantity        Int?
  startDate          DateTime
  endDate            DateTime?
  usageLimit         Int?
  timesUsed          Int             @default(0)
  productId          String?
  applyToWholeSub    Boolean         @default(true)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  usages             DiscountUsage[]

  @@index([code])
  @@index([isActive])
}

model DiscountUsage {
  id             String       @id @default(uuid())
  discountId     String
  invoiceId      String
  subscriptionId String?
  customerId     String
  amountApplied  Decimal      @db.Decimal(12, 2)
  usedAt         DateTime     @default(now())

  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Restrict)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([discountId])
  @@index([invoiceId])
}

model Invoice {
  id             String          @id @default(uuid())
  invoiceNumber  String          @unique
  subscriptionId String
  customerId     String
  periodStart    DateTime
  periodEnd      DateTime
  invoiceDate    DateTime        @default(now())
  dueDate        DateTime
  status         InvoiceStatus   @default(DRAFT)
  subtotal       Decimal         @db.Decimal(12, 2)
  taxAmount      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  amountPaid     Decimal         @default(0.00) @db.Decimal(12, 2)
  balanceDue     Decimal         @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       Payment[]
  discountUsages DiscountUsage[]

  @@unique([subscriptionId, periodStart])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id             String          @id @default(uuid())
  invoiceId      String
  productId      String
  variantId      String?
  description    String
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  paymentNumber String        @unique
  invoiceId     String
  customerId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paymentDate   DateTime      @default(now())
  referenceNote String?
  recordedById  String?
  createdAt     DateTime      @default(now())

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy    User?         @relation("StaffPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([customerId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model BusinessSettings {
  id             String   @id @default(uuid())
  companyName    String   @default("Brightloop Software")
  currency       String   @default("INR")
  currencySymbol String   @default("₹")
  taxNumber      String?  @default("US-BL-849204")
  contactEmail   String   @default("billing@brightloop.io")
  contactPhone   String   @default("+1 (555) 019-2834")
  address        String   @default("100 Innovation Way, Suite 400, Tech City, TC 94016")
  invoicePrefix  String   @default("INV")
  quotationPrefix String  @default("QT")
  subPrefix      String   @default("SUB")
  updatedAt      DateTime @updatedAt
}

